CREATE TABLE ksiazki (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    tytul TEXT NOT NULL,
    autor TEXT NOT NULL
);

CREATE TABLE wypozyczenia (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    ksiazka_id INTEGER NOT NULL,
    osoba TEXT NOT NULL,
    data_wypozyczenia DATETIME DEFAULT CURRENT_TIMESTAMP,
    data_zwrotu DATETIME,
    FOREIGN KEY (ksiazka_id) REFERENCES ksiazki(id)
);


aplikacja ma być uruchomiona w kontenerze (docker) i dostępna na porcie 7001
